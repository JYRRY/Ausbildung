# JYRY AI — Environment variables (copy to .env and fill)

# === App ===
JYRY_ENV=production           # production | development | testing
JYRY_LOG_LEVEL=INFO
JYRY_TIMEZONE=Europe/Berlin

# === Telegram ===
TELEGRAM_BOT_TOKEN=                       # from @BotFather
TELEGRAM_BOT_USERNAME=JYRY_AI_bot
TELEGRAM_ADMIN_IDS=                       # comma-separated numeric IDs
# Channel users must be subscribed to before they can use the bot.
# The bot must be admin in this channel. Format: @channelname or -100... ID.
# Leave empty to disable the gate.
TELEGRAM_REQUIRED_CHANNEL=

# === Encryption ===
# 32-byte URL-safe base64 key. Generate once with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# === Database (PostgreSQL) ===
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=jyry
POSTGRES_USER=jyry
POSTGRES_PASSWORD=
DATABASE_URL=postgresql+asyncpg://jyry:CHANGE_ME@127.0.0.1:5432/jyry

# === Redis ===
REDIS_URL=redis://127.0.0.1:6379/0

# === Bundesagentur für Arbeit Jobsuche API ===
BA_API_BASE=https://rest.arbeitsagentur.de/jobboerse/jobsuche-service/pc/v4/jobs
BA_API_KEY=jobboerse-jobsuche
BA_CACHE_TTL_SECONDS=86400               # 24h

# === Sending engine (per-user Gmail SMTP) ===
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_STARTTLS=true
# Sending starts immediately when the user finishes onboarding and paces
# the daily quota across whatever time remains in the day in JYRY_TIMEZONE.
SEND_MIN_INTERVAL_SECONDS=60        # floor between two outbound emails per user
SEND_JITTER_SECONDS=20              # +/- on every scheduled tick
SEND_NO_POSTING_BACKOFF_SECONDS=1800
SEND_TRANSIENT_RETRY_SECONDS=300,1800,7200

# === Paddle (Merchant of Record) ===
# Use the Sandbox host until everything is wired and tested end-to-end, then
# flip to https://api.paddle.com plus the live API key, webhook secret and
# Price IDs. Two completely separate accounts live behind those hosts.
PADDLE_API_BASE=https://sandbox-api.paddle.com
# Paddle dashboard → Developer Tools → Authentication → "Generate API key"
PADDLE_API_KEY=
# Paddle dashboard → Developer Tools → Notifications → "Add endpoint" → copy
# the signing secret it gives you. Required to verify webhook authenticity.
PADDLE_WEBHOOK_SECRET=
# Paddle dashboard → Catalog → Products → open each product → copy the price
# ID (starts with "pri_…"). One per plan.
PADDLE_PRICE_PLUS=
PADDLE_PRICE_PRO=
PADDLE_PRICE_MAX=

# === Webhook server (FastAPI) ===
# The webhook listens on $WEBHOOK_HOST:$WEBHOOK_PORT internally; nginx
# fronts it with TLS at WEBHOOK_PUBLIC_URL/webhook/paddle.
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8080
WEBHOOK_PUBLIC_URL=                      # e.g. https://bot.jyrygroup.com
