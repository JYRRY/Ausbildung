# JYRY AI — Environment variables (copy to .env and fill)

# === App ===
JYRY_ENV=production           # production | development | testing
JYRY_LOG_LEVEL=INFO
JYRY_TIMEZONE=Europe/Berlin

# === Telegram ===
TELEGRAM_BOT_TOKEN=                       # from @BotFather
TELEGRAM_BOT_USERNAME=JYRY_AI_bot
TELEGRAM_ADMIN_IDS=                       # comma-separated numeric IDs

# === Encryption ===
# 32-byte URL-safe base64 key. Generate once with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# === Database (PostgreSQL) ===
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=jyry
POSTGRES_USER=jyry
POSTGRES_PASSWORD=
DATABASE_URL=postgresql+asyncpg://jyry:CHANGE_ME@127.0.0.1:5432/jyry

# === Redis ===
REDIS_URL=redis://127.0.0.1:6379/0

# === Bundesagentur für Arbeit Jobsuche API ===
BA_API_BASE=https://rest.arbeitsagentur.de/jobboerse/jobsuche-service/pc/v4/jobs
BA_API_KEY=jobboerse-jobsuche
BA_CACHE_TTL_SECONDS=86400               # 24h

# === Sending engine (per-user Gmail SMTP) ===
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_STARTTLS=true
SEND_WINDOW_START=08:00                  # local hours, JYRY_TIMEZONE
SEND_WINDOW_END=22:00
SEND_JITTER_MINUTES=15
SEND_BATCH_GLOBAL_RPS=2                  # global cap to avoid noisy-neighbor

# === Lemon Squeezy ===
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=
LEMONSQUEEZY_VARIANT_BASIC=
LEMONSQUEEZY_VARIANT_PRO=
LEMONSQUEEZY_VARIANT_MAX=

# === Webhook server (FastAPI) ===
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8080
WEBHOOK_PUBLIC_URL=                      # e.g. https://jyry.example.com
