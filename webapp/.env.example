# Public origin for the FastAPI dashboard backend (server-side calls).
# In production this is the same host as the frontend.
NEXT_PUBLIC_API_BASE=https://bot.jyrygroup.com

# Server-side base used by Next.js server components to reach the FastAPI
# process. Points to localhost since both run on the same box.
INTERNAL_API_BASE=http://127.0.0.1:8001

# Used to sanity-check the session cookie on the Next.js side (we don't
# verify the JWT — that's the API's job — we only read it to decide
# whether to redirect to /signin).
SESSION_COOKIE_NAME=jyry_session
